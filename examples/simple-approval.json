{
	"format": "directus-node-graph-ruleset",
	"schemaVersion": 1,
	"key": "simple-approval",
	"version": 1,
	"name": "Simple approval",
	"direction": "LR",
	"dataTypes": [
		{ "key": "flow", "label": "Control flow", "color": "var(--theme--primary)" }
	],
	"nodeTypes": [
		{
			"key": "start", "label": "Start", "icon": "play_arrow", "category": "Flow",
			"deletable": false, "limits": { "minInstances": 1, "maxInstances": 1 },
			"titleTemplate": "{{title}}",
			"fields": [
				{ "field": "title", "name": "Title", "type": "string", "meta": { "interface": "input", "width": "full" } }
			],
			"outputs": [{ "key": "next", "label": "Next", "dataType": "flow", "minConnections": 1, "maxConnections": 1 }]
		},
		{
			"key": "task", "label": "Task", "icon": "task_alt", "category": "Steps",
			"titleTemplate": "{{title}}", "summaryFields": ["assignee"],
			"fields": [
				{ "field": "title", "name": "Title", "type": "string", "meta": { "interface": "input", "width": "full", "required": true } },
				{ "field": "assignee", "name": "Assignee", "type": "string", "meta": { "interface": "select-dropdown", "width": "half", "options": { "choices": [
					{ "text": "Team lead", "value": "lead" },
					{ "text": "Security", "value": "security" }
				] } } }
			],
			"inputs": [{ "key": "in", "label": "In", "dataType": "flow", "minConnections": 1 }],
			"outputs": [{ "key": "next", "label": "Next", "dataType": "flow", "maxConnections": 1 }]
		},
		{
			"key": "decision", "label": "Decision", "icon": "call_split", "category": "Steps",
			"titleTemplate": "{{question}}",
			"fields": [
				{ "field": "question", "name": "Question", "type": "string", "meta": { "interface": "input", "width": "full" } }
			],
			"inputs": [{ "key": "in", "label": "In", "dataType": "flow", "minConnections": 1 }],
			"outputs": [
				{ "key": "yes", "label": "Yes", "dataType": "flow", "maxConnections": 1 },
				{ "key": "no", "label": "No", "dataType": "flow", "maxConnections": 1 }
			]
		},
		{
			"key": "end", "label": "End", "icon": "stop_circle", "category": "Flow",
			"limits": { "minInstances": 1 },
			"titleTemplate": "End: {{outcome}}",
			"fields": [
				{ "field": "outcome", "name": "Outcome", "type": "string", "meta": { "interface": "select-dropdown", "options": { "choices": [
					{ "text": "Approved", "value": "approved" },
					{ "text": "Rejected", "value": "rejected" }
				] } } }
			],
			"inputs": [{ "key": "in", "label": "In", "dataType": "flow", "minConnections": 1 }]
		}
	],
	"edgeTypes": [
		{
			"key": "flow", "label": "Flow", "style": { "path": "step", "marker": "arrow" },
			"labelTemplate": "{{label}}",
			"fields": [
				{ "field": "label", "name": "Label", "type": "string", "meta": { "interface": "input" } }
			]
		}
	],
	"connectionRules": {
		"defaultEdgeType": "flow",
		"typeCheck": "strict",
		"allowSelfLoops": false,
		"allowCycles": true,
		"pairs": { "mode": "deny", "rules": [
			{ "source": "start", "target": "end", "message": "Start cannot go straight to End." }
		] }
	},
	"graphRules": {
		"entryNodeTypes": ["start"],
		"requireReachableFromEntry": true,
		"maxNodes": 100
	}
}
